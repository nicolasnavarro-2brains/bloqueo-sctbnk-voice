# Dockerfile para Twilio Voice Server
FROM python:3.10.12-slim

# Establecer directorio de trabajo
WORKDIR /app

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements específicos para Twilio
COPY requirements-twilio.txt /app/

# Instalar dependencias de Python
RUN pip install --no-cache-dir -r requirements-twilio.txt

# Copiar código de la aplicación
COPY twilio_voice_server.py /app/
COPY elevenlabs_tts.py /app/
# .env no se copia - las variables vienen de Secret Manager en Cloud Run

# Crear carpeta para audio (aunque ahora usa RAM)
RUN mkdir -p /app/audio

# Exponer puerto
EXPOSE 5000

# Variables de entorno por defecto
ENV PORT=5000
ENV PYTHONUNBUFFERED=1

# Comando para ejecutar el servidor
CMD ["python", "twilio_voice_server.py"]

