# ========================================
# CONFIGURACIÓN DEL SERVIDOR TWILIO VOICE
# ========================================

# Puerto del servidor Flask
PORT=5000

# Modo debug (True/False)
DEBUG=False

# ========================================
# CONFIGURACIÓN DE RASA PRO
# ========================================

# Licencia de Rasa Pro
RASA_PRO_LICENSE=""

# URL del webhook de Rasa Pro
RASA_WEBHOOK_URL=http://localhost:5005/webhooks/rest/webhook

# ========================================
# CONFIGURACIÓN DE TWILIO
# ========================================

# Account SID de Twilio
TWILIO_ACCOUNT_SID=

# Auth Token de Twilio
TWILIO_AUTH_TOKEN=

# Número de teléfono para fallback (ejecutivo humano)
FALLBACK_PHONE_NUMBER=

# ========================================
# CONFIGURACIÓN DE VOZ (POLLY)
# Por si ElevenLabs deja de funcionar
# ========================================

# Voz de Amazon Polly a usar
POLLY_VOICE=Polly.Mia-Neural

# Idioma de la voz
POLLY_LANGUAGE=es-MX

# Velocidad de habla (0.5 = lento, 2.0 = rápido)
POLLY_SPEED=1.0

# ========================================
# CONFIGURACIÓN DE VOZ (ELEVENLABS)
# ========================================

# API Key de ElevenLabs
ELEVEN_API_KEY=

# ID de voz principal
ELEVEN_VOICE_ID=

# ID de voz secundaria
ELEVEN_VOICE_ID2=

# ========================================
# CONFIGURACIÓN DE FRESHDESK
# ========================================

# API Key de Freshdesk
API_KEY=

# Dominio de Freshdesk (sin https:// y sin .freshdesk.com)
DOMAIN=

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================

# Host de la base de datos
DB_HOST=

# Usuario de la base de datos
DB_USER=

# Contraseña de la base de datos
DB_PASSWORD=

# Nombre de la base de datos
DB_NAME=

# Usar base de datos (True/False)
USE_DB=False

# ========================================
# CONFIGURACIÓN DE OPENAI
# ========================================

# API Key de OpenAI (ChatGPT)
OPENAI_API_KEY=

# ========================================
# CONFIGURACIÓN DE LOGGING
# ========================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO